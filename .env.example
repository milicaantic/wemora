# Copy to .env and fill in. Never commit .env.

# Needed only for real runs (`npm run migrate`). `--mock`, `verify` and tests work without it.
ANTHROPIC_API_KEY=

# Optional: a gateway instead of api.anthropic.com, e.g. the hackathon gateway (api.app.jigjoy.ai).
# ANTHROPIC_BASE_URL=

# Optional: other models (D-018). The defaults are claude-haiku-4-5 and claude-sonnet-4-6 (D-023),
# the ones the hackathon gateway serves, so these are needed only for another gateway.
# WEMORA_MODEL_DEFAULT=claude-haiku-4-5
# WEMORA_MODEL_STRONG=claude-sonnet-4-6

# Do NOT add MOZAIK_API_KEY or MOZAIK_PROJECT_KEY: they turn on Mozaik Cloud telemetry,
# which uploads agent memory and tool calls. See .claude/rules/mozaik.md §8.
